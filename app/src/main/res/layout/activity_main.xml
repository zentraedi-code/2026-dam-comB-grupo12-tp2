<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleTheme"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="🌙"
        android:textSize="22sp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/containerCenter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:scaleType="fitCenter"
            android:tint="@color/strongBlue"
            android:src="@drawable/natacion" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SportClubApp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/strongBlue"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión del club"
            android:textSize="18sp"
            android:textColor="@color/gray"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceder"
            android:layout_width="270dp"
            android:layout_height="52dp"
            android:text="ACCEDER"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/strongBlue"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRedes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnInstagram"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_instagram"
            android:tint="#E1306C"/>

        <ImageView
            android:id="@+id/btnLinkedin"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_linkedin"
            android:tint="@color/lightBlue"/>

        <ImageView
            android:id="@+id/btnYoutube"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_youtube"
            android:tint="@color/red"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>